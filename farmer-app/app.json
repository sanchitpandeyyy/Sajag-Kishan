{
  "expo": {
    "name": "कृषि दृष्टि",
    "slug": "krishidristi-farmer",
    "scheme": "krishidristi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "np.krishidristi.farmer",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "तपाईंको बोली लेखमा बदल्न अनुमति चाहिन्छ। Used to turn your speech into text.",
        "NSMicrophoneUsageDescription": "प्रश्न बोलेर सोध्न माइक चाहिन्छ। Microphone is used to ask questions by voice."
      }
    },
    "android": {
      "package": "np.krishidristi.farmer",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#075426"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "खेतको फोटो खिच्न क्यामेरा चाहिन्छ। The camera is used to photograph your field.",
          "photosPermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "खेतको स्थान राख्न लोकेसन चाहिन्छ। Location is used to save where your field is."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "प्रश्न बोलेर सोध्न माइक चाहिन्छ। Microphone is used to ask questions by voice."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "079ff711-b28e-4290-a28c-0fce20eab8d6"
      }
    },
    "owner": "sanchitpandeyyy"
  }
}
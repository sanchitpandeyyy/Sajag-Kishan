# ── Neon (do not hand-write) ─────────────────────────────────────────────
# `neon deploy` (or `neon env pull`) writes these to backend/.env.local:
#   DATABASE_URL            pooled (-pooler) — used by the app (node-postgres via Prisma)
#   DATABASE_URL_UNPOOLED   direct — used by `prisma migrate` (see prisma.config.ts)
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3, AWS_REGION
#                           Neon Object Storage, bucket "assets" declared in neon.ts
#   NEON_BRANCH, NEON_BRANCH_ID, NEON_FUNCTION_HOST_SUFFIX

# ── App settings (put these in backend/.env) ─────────────────────────────
API_PORT=8787
# Optional pool size per API process (default 10)
DATABASE_POOL_MAX=10
# Better Auth
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
# Public URL of this API
BETTER_AUTH_URL="http://localhost:8787"
# Comma-separated list of allowed web origins
CORS_ORIGINS="http://localhost:3000"

# Optional: Nepali chat with Claude. Without it the chat still works ("local" mode).
# ANTHROPIC_API_KEY=""
# CHAT_MODEL="claude-opus-5-5"

# Nepali chat + voice with Gemini (preferred). Flow: Nepali -> English -> answer -> Nepali.
# Get a key at https://aistudio.google.com/apikey . Without it the chat falls back to Claude, then local mode.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
# If that model fails (retired, busy, timeout) these are tried in order, silently:
# GEMINI_FALLBACK_MODELS="gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash"
